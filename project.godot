; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="fighter"
run/main_scene="res://scenes/Menu.tscn"
config/features=PackedStringArray("4.7")

[autoload]

InputSetup="*res://scripts/InputSetup.gd"
Effects="*res://scripts/Effects.gd"
GameState="*res://scripts/GameState.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/alagard.ttf"

[rendering]

renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=2
#Forward+givesthedesktopbuildhigher-qualitylighting,shadows,and#screen-spaceeffects.Mobilekeepsthecompatibilityfallbackbelow.renderer/rendering_method="forward_plus"
